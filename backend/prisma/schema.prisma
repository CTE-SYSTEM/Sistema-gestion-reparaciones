generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// para logica de el sistema de perfiles y usuarios

model Usuarios {
  id_usuario         Int      @id @default(autoincrement())
  nombre_usuario     String   @unique
  contrasena_hash    String
  correo_electronico String?
  rol                String   // Admin, Jefe Tecnico, Tecnico, Recepcion
  activo             Boolean  @default(true)
  sesion_version     Int      @default(0)
  fecha_creacion     DateTime @default(now())
  tecnico            Tecnicos?
  archivos_servicio  ArchivosServicio[]
  archivos_compra ArchivosCompra[]
  historial_diagnosticos HistorialDiagnosticos[]
  historial_ordenes HistorialOrdenes[]
  entregas_ordenes Ordenes[] @relation("OrdenEntregadaPor")
  aprobaciones_repuestos Ordenes_Repuestos[] @relation("AprobadorRepuesto")
  entregas_repuestos Ordenes_Repuestos[] @relation("EntregadorRepuesto")
  revisiones_irreparable Ordenes[] @relation("RevisorIrreparable")
  asignaciones_registradas HistorialAsignaciones[]
  intervenciones_tecnicas IntervencionesTecnicas[]
  avances_tecnicos BitacoraTecnica[]
  notificaciones Notificaciones[]
  recuperacion_password RecuperacionPassword?
  reclamos_abiertos Reclamos[] @relation("ReclamoAbiertoPor")
  reclamos_analizados Reclamos[] @relation("ReclamoAnalizadoPor")
  reclamos_decididos Reclamos[] @relation("ReclamoDecididoPor")
  revisiones_calidad RevisionesCalidad[]
  movimientos_contables MovimientosContables[]

  @@map("Usuarios")
}

model RecuperacionPassword {
  usuario_id     Int      @id
  codigo_hash    String
  expira_en      DateTime @db.Timestamptz(3)
  solicitado_en  DateTime @default(now()) @db.Timestamptz(3)
  intentos       Int      @default(0)
  usuario        Usuarios @relation(fields: [usuario_id], references: [id_usuario], onDelete: Cascade)

  @@map("RecuperacionPassword")
}

model Notificaciones {
  id          String    @db.Uuid
  usuario_id  Int
  contenido   Json
  fecha_hora  DateTime  @default(now())
  leida_en    DateTime?
  usuario     Usuarios  @relation(fields: [usuario_id], references: [id_usuario], onDelete: Cascade)

  @@id([id, usuario_id])
  @@index([usuario_id, leida_en, fecha_hora])
  @@map("Notificaciones")
}

// --- CLIENTES Y EQUIPOS ---

model Clientes {
  id_cliente          Int       @id @default(autoincrement())
  nombre              String    
  telefono            String?   @unique
  direccion           String?   
  correo              String?   
  contacto_secundario String?   
  activo              Boolean   @default(true)
  equipos             Equipos[]


  @@map("Clientes")
}

model Equipos {
  id_equipo    Int           @id @default(autoincrement())
  cliente_id   Int
  marca        String?       
  tipo         String?       
  numero_serie String?       
  modelo       String?       
  observaciones_generales String?
  cliente      Clientes      @relation(fields: [cliente_id], references: [id_cliente])
  diagnosticos Diagnosticos[]

  @@map("Equipos")
}

// --- FLUJO DE TRABAJO ---

model Tecnicos {
  id_tecnico   Int       @id @default(autoincrement())
  usuario_id   Int?      @unique
  usuario      Usuarios? @relation(fields: [usuario_id], references: [id_usuario], onDelete: Cascade)
  nombre       String    
  especialidad String?   // Ejemplo: Microelectrónica, Laptops, Celulares
  horario      String?   // Ejemplo: "Lunes a Viernes 08:00 - 17:00"
  contacto     String?   // Teléfono o medio de comunicación interno
  activo       Boolean   @default(true)

  diagnosticos Diagnosticos[]
  disponibilidad String @default("DISPONIBLE")
  observacion_disponibilidad String?
  asignaciones_anteriores HistorialAsignaciones[] @relation("TecnicoAnterior")
  asignaciones_nuevas HistorialAsignaciones[] @relation("TecnicoNuevo")
  ordenes      Ordenes[]
  solicitudes_repuestos Ordenes_Repuestos[] @relation("SolicitanteRepuesto")

  @@map("Tecnicos")
}

model Diagnosticos {
  id_diagnostico          Int       @id @default(autoincrement())
  equipo_id               Int
  origen_directo          Boolean   @default(false)
  tecnico_id              Int?      // Permite que sea nulo hasta asignar técnico
  falla_reportada         String?   
  diagnostico_real        String?  
  solucion_propuesta      String?
  borrador_tecnico        Json?
  fecha_borrador          DateTime?
  presupuesto_estimado    Decimal?  @db.Decimal(18, 2)
  moneda_presupuesto      String    @default("NIO") @db.VarChar(3)
  prioridad               String?   @default("Normal") // Urgente - Alta - Normal
  fecha_hora              DateTime? @default(now())
  fecha_asignacion        DateTime?
  fecha_completado        DateTime?
  fecha_inicio            DateTime?
  fecha_retiro_sin_reparar DateTime?
  estado_contacto         String    @default("PENDIENTE_CONTACTAR")
  fecha_envio_documento   DateTime?
  fecha_respuesta_cliente DateTime?
  observacion_respuesta   String?
  estado_equipo           String    @default("EN_TALLER")
  persona_recibe_retiro   String?
  observacion_retiro      String?
  estado_cargador         String?   @default("NO_VERIFICADO")
  estado_accesorios       String?   @default("NO_VERIFICADOS")
  estado_fisico           String?   @default("NO_VERIFICADO")
  estado_encendido        String?   @default("NO_PROBADO")
  estado_alimentacion     String?   @default("NO_PROBADA")
  estado_acceso           String?   @default("NO_VERIFICADO")
  detalle_accesorios      String?
  observaciones_recepcion String?
  
  // Estados
  estado_del_diagnostico  String    @default("PENDIENTE") // PENDIENTE, EN_REVISION, COMPLETADO
  Estado_aprobacion       String    @default("Pendiente") // Pendiente, Aprobado, Rechazado 

  // Checks de Recepción
  deja_cargador           Boolean   @default(false)
  enciende                Boolean   @default(false)
  usa_corriente_ac        Boolean   @default(false)

  // Relaciones
  equipo                  Equipos   @relation(fields: [equipo_id], references: [id_equipo])
  tecnico                 Tecnicos? @relation(fields: [tecnico_id], references: [id_tecnico]) // Corregido: Tecnicos?
  ordenes                 Ordenes[]
  archivos                ArchivosServicio[]
  historial_estados       HistorialDiagnosticos[]
  historial_asignaciones HistorialAsignaciones[]
  intervenciones IntervencionesTecnicas[]
  avances_tecnicos BitacoraTecnica[]
  factura_diagnostico Facturas?

  @@map("Diagnosticos")
}

model Ordenes {
  id_orden                Int       @id @default(autoincrement())
  diagnostico_id          Int
  tecnico_id              Int?      // Permite que sea nulo al inicio
  prioridad               String?   // Urgente - Alta - Normal
  estado                  String?   @default("PENDIENTE") // PENDIENTE, EN_REVISION, EN_REPARACION, FINALIZADO, IRREPARABLE, ENTREGADO
  fecha_ingreso           DateTime? @default(now())
  fecha_asignacion        DateTime?
  resultado_final         String?
  enciende_salida         Boolean?
  usa_corriente_ac_salida Boolean?
  observacion_final       String?
  pruebas_salida          Json?
  fecha_cierre            DateTime?
  fecha_finalizacion      DateTime?
  monto_autorizado        Decimal?  @db.Decimal(18, 2)
  fecha_aprobacion_cliente DateTime?
  fecha_inicio_reparacion DateTime?
  fecha_entrega           DateTime?
  fecha_cancelacion       DateTime?
  motivo_cancelacion      String?
  entregado_por_id        Int?
  persona_recibe          String?
  observacion_entrega     String?
  requiere_piezas         Boolean   @default(true)
  justificacion_irreparable String?
  irreparable_estado      String    @default("NO_SOLICITADO")
  usuario_revisor_irreparable_id Int?
  fecha_revision_irreparable DateTime?
  motivo_revision_irreparable String?
  es_garantia             Boolean   @default(false)
  calidad_estado          String    @default("NO_REQUERIDO")
  calidad_observacion     String?
  calidad_revisada_en     DateTime?
  
  // Relaciones
  diagnostico             Diagnosticos @relation(fields: [diagnostico_id], references: [id_diagnostico])
  tecnico                 Tecnicos?    @relation(fields: [tecnico_id], references: [id_tecnico]) // Corregido: Tecnicos?
  entregado_por           Usuarios?    @relation("OrdenEntregadaPor", fields: [entregado_por_id], references: [id_usuario], onDelete: SetNull)
  
  repuestos_usados        Ordenes_Repuestos[]
  facturas                Facturas[]
  archivos                ArchivosServicio[]
  historial_estados       HistorialOrdenes[]
  historial_asignaciones HistorialAsignaciones[]
  intervenciones IntervencionesTecnicas[]
  avances_tecnicos BitacoraTecnica[]
  revisor_irreparable Usuarios? @relation("RevisorIrreparable", fields: [usuario_revisor_irreparable_id], references: [id_usuario], onDelete: SetNull)
  reclamos_originales Reclamos[] @relation("ReclamoOrdenOriginal")
  reclamo_reingreso Reclamos? @relation("ReclamoOrdenReingreso")
  revisiones_calidad RevisionesCalidad[]

  @@map("Ordenes")
}

// --- REPUESTOS E INVENTARIO (BAJO PEDIDO) ---

model Categorias_Repuestos {
  id_tipo_repuesto Int                 @id @default(autoincrement())
  nombre_tipo      String?             
  electronico      String?             
  repuestos        Repuestos[]

  @@map("Categorias_Repuestos")
}

model Repuestos {
  id_repuesto       Int                  @id @default(autoincrement())
  tipo_repuesto_id  Int
  proveedor_id      Int?
  nombre            String?
  descripcion       String?
  costo_individual Decimal?             @db.Decimal(18, 2) // Se actualiza con la última compra se necesita un trigger
  porcentaje_de_ganacia     Decimal?             @db.Decimal(18, 2) // Campo legado: conservar para no perder datos existentes
  ganancia_cordobas Decimal?             @db.Decimal(18, 2)
  stock_actual     Int                  @default(0)
  stock_minimo     Int                  @default(0)
  ubicacion_fisica String?
  activo           Boolean              @default(true) // Campo legado: conservar para compatibilidad con datos/scripts existentes
  descontinuada     Boolean              @default(false)

  categoria        Categorias_Repuestos @relation(fields: [tipo_repuesto_id], references: [id_tipo_repuesto])
  proveedor        Proveedores?         @relation(fields: [proveedor_id], references: [id_proveedor])
  compras          Compras[]
  ordenes_detalles Ordenes_Repuestos[]

  @@map("Repuestos")
}

model Ordenes_Repuestos {
  id_detalle_repuesto Int       @id @default(autoincrement())
  orden_id            Int
  repuesto_id         Int?
  pieza_solicitada    String?
  cantidad_usada      Int?      @default(1)
  estado_entrega      String    @default("PENDIENTE") // PENDIENTE, ENTREGADO
  fecha_entrega       DateTime?
  fecha_solicitud     DateTime  @default(now())
  fecha_aprobacion    DateTime?
  fecha_rechazo       DateTime?
  motivo_rechazo      String?
  tecnico_solicitante_id Int?
  usuario_aprobador_id Int?
  usuario_entregador_id Int?
  compra_id            Int?
  precio_unitario_facturado Decimal? @db.Decimal(18, 2)
  total_facturado     Decimal? @db.Decimal(18, 2)
  fecha_facturacion   DateTime?
  
  // El Check de aprobación del Jefe Técnico 
  estado_aprobacion   String    @default("PENDIENTE") // PENDIENTE, APROBADO, DENEGADO
  
  orden               Ordenes   @relation(fields: [orden_id], references: [id_orden])
  repuesto            Repuestos? @relation(fields: [repuesto_id], references: [id_repuesto])
  tecnico_solicitante Tecnicos? @relation("SolicitanteRepuesto", fields: [tecnico_solicitante_id], references: [id_tecnico], onDelete: SetNull)
  usuario_aprobador Usuarios? @relation("AprobadorRepuesto", fields: [usuario_aprobador_id], references: [id_usuario], onDelete: SetNull)
  usuario_entregador Usuarios? @relation("EntregadorRepuesto", fields: [usuario_entregador_id], references: [id_usuario], onDelete: SetNull)
  compra              Compras? @relation(fields: [compra_id], references: [id_compra], onDelete: SetNull)

  @@map("Ordenes_Repuestos")
}

// --- COMPRAS Y PROVEEDORES ---

model Proveedores {
  id_proveedor Int       @id @default(autoincrement())
  nombre       String    
  telefono     String?   
  direccion    String?   
  correo       String?
  web          String?   
  notas        String?   // Para anotar horarios o si tienen buenos repuestos o si incluso hubo problemas con las piezas
  nombre_contacto String?
  horario_atencion String?
  descontinuada    Boolean @default(true)
  repuestos    Repuestos[]
  compras      Compras[]

  @@map("Proveedores")
}

model Compras {
  id_compra        Int         @id @default(autoincrement())
  repuesto_id      Int
  proveedor_id     Int
  documento        String?     // Número de recibo o factura de la tienda
  fecha_obtencion  DateTime?   @default(now())
  cantidad         Int?
  costo_unitario   Decimal?    @db.Decimal(18, 2)
  metodo_pago      String?     // Efectivo, Transferencia
  
  proveedor        Proveedores @relation(fields: [proveedor_id], references: [id_proveedor])
  repuesto         Repuestos   @relation(fields: [repuesto_id], references: [id_repuesto])
  archivos         ArchivosCompra[]
  salidas_asignadas Ordenes_Repuestos[]
  reclamos        Reclamos[]

  @@map("Compras")
}

// --- FACTURACIÓN Y POST-VENTA ---

model Facturas {
  id_factura    Int       @id @default(autoincrement())
  orden_id      Int?      @unique
  diagnostico_id Int?    @unique
  fecha_emision DateTime? @default(now())
  monto_repuestos Decimal? @db.Decimal(18, 2) // La suma de lo que se uso
  mano_obra       Decimal? @db.Decimal(18, 2) // El costo del servicio técnico
  monto_diagnostico Decimal? @default(0) @db.Decimal(18, 2)
  
  subtotal      Decimal?  @db.Decimal(18, 2) // monto repuestos + mano de obra
  impuestos     Decimal?  @db.Decimal(18, 2)
  total         Decimal?  @db.Decimal(18, 2)
  
  metodo_pago   String?   
  orden         Ordenes?   @relation(fields: [orden_id], references: [id_orden])
  diagnostico   Diagnosticos? @relation(fields: [diagnostico_id], references: [id_diagnostico])
  garantias     Garantias[]
  movimientos_contables MovimientosContables[]

  @@map("Facturas")
}

model ArchivosCompra {
  id_archivo Int @id @default(autoincrement())
  compra_id Int
  ruta_archivo String
  nombre_original String
  tipo_mime String
  fecha_subida DateTime @default(now())
  usuario_id Int?
  compra Compras @relation(fields: [compra_id], references: [id_compra], onDelete: Cascade)
  usuario Usuarios? @relation(fields: [usuario_id], references: [id_usuario], onDelete: SetNull)
  @@index([compra_id, fecha_subida])
  @@map("ArchivosCompra")
}

model ArchivosServicio {
  id_archivo Int @id @default(autoincrement())
  diagnostico_id Int?
  orden_id Int?
  tipo_archivo String
  ruta_archivo String
  nombre_original String
  tipo_mime String
  fecha_subida DateTime @default(now())
  usuario_id Int?
  visible_tecnico Boolean @default(false)
  diagnostico Diagnosticos? @relation(fields: [diagnostico_id], references: [id_diagnostico], onDelete: Cascade)
  orden Ordenes? @relation(fields: [orden_id], references: [id_orden], onDelete: Cascade)
  usuario Usuarios? @relation(fields: [usuario_id], references: [id_usuario], onDelete: SetNull)

  @@index([diagnostico_id, fecha_subida])
  @@index([orden_id, fecha_subida])
  @@map("ArchivosServicio")
}

model BitacoraTecnica {
  id_avance Int @id @default(autoincrement())
  diagnostico_id Int?
  orden_id Int?
  usuario_id Int?
  observacion String
  fecha_hora DateTime @default(now())
  diagnostico Diagnosticos? @relation(fields: [diagnostico_id], references: [id_diagnostico], onDelete: Cascade)
  orden Ordenes? @relation(fields: [orden_id], references: [id_orden], onDelete: Cascade)
  usuario Usuarios? @relation(fields: [usuario_id], references: [id_usuario], onDelete: SetNull)
  @@index([diagnostico_id, fecha_hora])
  @@index([orden_id, fecha_hora])
  @@map("BitacoraTecnica")
}

model HistorialDiagnosticos {
  id_historial Int @id @default(autoincrement())
  diagnostico_id Int
  proceso String
  estado_anterior String?
  estado_nuevo String
  fecha_hora DateTime @default(now())
  usuario_id Int?
  observacion String?
  diagnostico Diagnosticos @relation(fields: [diagnostico_id], references: [id_diagnostico], onDelete: Cascade)
  usuario Usuarios? @relation(fields: [usuario_id], references: [id_usuario], onDelete: SetNull)

  @@index([diagnostico_id, fecha_hora])
  @@map("HistorialDiagnosticos")
}

model HistorialOrdenes {
  id_historial Int @id @default(autoincrement())
  orden_id Int
  estado_anterior String?
  estado_nuevo String
  fecha_hora DateTime @default(now())
  usuario_id Int?
  observacion String?
  orden Ordenes @relation(fields: [orden_id], references: [id_orden], onDelete: Cascade)
  usuario Usuarios? @relation(fields: [usuario_id], references: [id_usuario], onDelete: SetNull)

  @@index([orden_id, fecha_hora])
  @@map("HistorialOrdenes")
}

model HistorialAsignaciones {
  id_historial Int @id @default(autoincrement())
  diagnostico_id Int?
  orden_id Int?
  tecnico_anterior_id Int?
  tecnico_nuevo_id Int?
  tecnico_anterior_nombre String?
  tecnico_nuevo_nombre String?
  usuario_id Int?
  motivo String
  es_excepcion Boolean @default(false)
  fecha_hora DateTime @default(now())
  diagnostico Diagnosticos? @relation(fields: [diagnostico_id], references: [id_diagnostico], onDelete: Cascade)
  orden Ordenes? @relation(fields: [orden_id], references: [id_orden], onDelete: Cascade)
  tecnico_anterior Tecnicos? @relation("TecnicoAnterior", fields: [tecnico_anterior_id], references: [id_tecnico], onDelete: SetNull)
  tecnico_nuevo Tecnicos? @relation("TecnicoNuevo", fields: [tecnico_nuevo_id], references: [id_tecnico], onDelete: SetNull)
  usuario Usuarios? @relation(fields: [usuario_id], references: [id_usuario], onDelete: SetNull)
  @@index([diagnostico_id, fecha_hora])
  @@index([orden_id, fecha_hora])
  @@map("HistorialAsignaciones")
}

model IntervencionesTecnicas {
  id_intervencion Int @id @default(autoincrement())
  diagnostico_id Int?
  orden_id Int?
  tipo String
  motivo String
  usuario_id Int?
  datos_anteriores Json
  datos_nuevos Json
  fecha_hora DateTime @default(now())
  diagnostico Diagnosticos? @relation(fields: [diagnostico_id], references: [id_diagnostico], onDelete: Cascade)
  orden Ordenes? @relation(fields: [orden_id], references: [id_orden], onDelete: Cascade)
  usuario Usuarios? @relation(fields: [usuario_id], references: [id_usuario], onDelete: SetNull)
  @@index([diagnostico_id, fecha_hora])
  @@index([orden_id, fecha_hora])
  @@map("IntervencionesTecnicas")
}

model Garantias {
  id_garantia       Int       @id @default(autoincrement())
  factura_id        Int       @unique
  condiciones       String?   
  duracion_meses    Int?
  fecha_inicio      DateTime? 
  fecha_vencimiento DateTime? 
  factura           Facturas  @relation(fields: [factura_id], references: [id_factura])
  reclamos          Reclamos[]

  @@map("Garantias")
}

model Reclamos {
  id_reclamo             Int       @id @default(autoincrement())
  orden_original_id      Int
  garantia_id            Int?
  orden_reingreso_id     Int?      @unique
  compra_id              Int?
  descripcion            String
  estado                 String    @default("ABIERTO")
  responsable_tipo       String?
  analisis               String?
  resolucion             String?
  cobertura              String    @default("PENDIENTE")
  motivo_cobertura       String?
  costo_estimado         Decimal?  @db.Decimal(18, 2)
  abierto_por_id         Int
  analizado_por_id       Int?
  decidido_por_id        Int?
  fecha_apertura         DateTime  @default(now())
  fecha_analisis         DateTime?
  fecha_decision         DateTime?
  fecha_cierre           DateTime?
  orden_original         Ordenes   @relation("ReclamoOrdenOriginal", fields: [orden_original_id], references: [id_orden])
  orden_reingreso        Ordenes?  @relation("ReclamoOrdenReingreso", fields: [orden_reingreso_id], references: [id_orden])
  garantia               Garantias? @relation(fields: [garantia_id], references: [id_garantia])
  compra                 Compras? @relation(fields: [compra_id], references: [id_compra])
  abierto_por            Usuarios @relation("ReclamoAbiertoPor", fields: [abierto_por_id], references: [id_usuario])
  analizado_por          Usuarios? @relation("ReclamoAnalizadoPor", fields: [analizado_por_id], references: [id_usuario])
  decidido_por           Usuarios? @relation("ReclamoDecididoPor", fields: [decidido_por_id], references: [id_usuario])
  movimientos_contables  MovimientosContables[]

  @@index([estado, fecha_apertura(sort: Desc)])
  @@index([orden_original_id])
  @@map("Reclamos")
}

model RevisionesCalidad {
  id_revision     Int      @id @default(autoincrement())
  orden_id        Int
  usuario_id      Int
  decision        String
  observacion     String
  pruebas         Json?
  fecha_revision  DateTime @default(now())
  orden           Ordenes  @relation(fields: [orden_id], references: [id_orden])
  usuario         Usuarios @relation(fields: [usuario_id], references: [id_usuario])

  @@index([orden_id, fecha_revision(sort: Desc)])
  @@map("RevisionesCalidad")
}

model MovimientosContables {
  id_movimiento  Int      @id @default(autoincrement())
  factura_id     Int?
  reclamo_id     Int?
  usuario_id     Int
  tipo           String
  monto          Decimal  @db.Decimal(18, 2)
  metodo         String?
  referencia     String?
  motivo         String
  fecha_registro DateTime @default(now())
  factura        Facturas? @relation(fields: [factura_id], references: [id_factura])
  reclamo        Reclamos? @relation(fields: [reclamo_id], references: [id_reclamo])
  usuario        Usuarios  @relation(fields: [usuario_id], references: [id_usuario])

  @@index([factura_id, fecha_registro(sort: Desc)])
  @@index([reclamo_id, fecha_registro(sort: Desc)])
  @@map("MovimientosContables")
}

model Auditoria_Movimientos {
  id_auditoria      BigInt   @id @default(autoincrement())
  tabla             String
  operacion         String
  registro_pk       Json?
  datos_anteriores  Json?
  datos_nuevos      Json?
  usuario_id        Int?
  usuario_nombre    String?
  origen            String?  @default("database")
  observacion       String?
  fecha_movimiento  DateTime @default(now()) @db.Timestamp(6)

  @@index([tabla, fecha_movimiento(sort: Desc)], map: "idx_auditoria_tabla_fecha")
  @@index([operacion, fecha_movimiento(sort: Desc)], map: "idx_auditoria_operacion_fecha")
  @@map("Auditoria_Movimientos")
}

model ConfiguracionAdministracion {
  id              Int      @id
  valores         Json
  revision        Int      @default(0)
  actualizado_por Int?
  actualizado_en  DateTime @default(now()) @db.Timestamptz(6)
}

model EstadoRespaldos {
  id                  Int       @id
  configuracion       String
  proxima_ejecucion   DateTime? @db.Timestamptz(6)
  ultimo_intento      DateTime? @db.Timestamptz(6)
  ultimo_exito        DateTime? @db.Timestamptz(6)
  reintentos          Int       @default(0)
  ultimo_error        String?
}
