# Base local al ejecutar el backend fuera de Docker.

DATABASE_URL=postgresql://User_admin:TuPasswordSeguro123!@localhost:5432/Centro_Tecnico_Electronico?schema=public
SQL_DATABASE_URL=postgresql://User_admin:TuPasswordSeguro123!@localhost:5432/Centro_Tecnico_Electronico

# Producción con Neon: configure estas variables como secretos del servidor.
# DATABASE_URL = URL agrupada (-pooler) de la base publicada, con sslmode=require.
# SQL_DATABASE_URL = URL directa de la misma base, con sslmode=require.
# Consulte docs/despliegue-vercel-neon.md; nunca guarde credenciales reales en Git.

# Server
PORT=5000
NODE_ENV=development
JWT_SECRET=tu_secreto_super_seguro
# Correos transaccionales de Resend. La clave y el remitente van solo en el backend.
RESEND_API_KEY=
# Para pruebas sin dominio: onboarding@resend.dev (solo al correo de tu cuenta Resend).
# Para enviar a clientes: use una dirección de un dominio propio verificado en Resend.
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=SGR Taller
# Opcional: dirección que recibirá respuestas a los correos.
RESEND_REPLY_TO_EMAIL=
REQUEST_BODY_LIMIT=1mb

# Nombre del negocio en los informes PDF. Personalizable para cada instalación.
PDF_NOMBRE_NEGOCIO=Servicio técnico

# CORS. Use la URL pública exacta del frontend en producción.
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# CORS_ORIGIN=http://localhost:5173,https://frontend-production-9a19.up.railway.app

# Admin credentials for development reference.
ADMIN_USER=admin_pro
ADMIN_PASS=admin123

# Fotos de recepción, diagnóstico, reparación y entrega en Cloudflare R2.
# Cree un bucket privado y un token R2 Object Read & Write limitado a ese bucket.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Opcional: endpoint S3 del bucket si usa una jurisdicción (eu, us o fedramp).
R2_ENDPOINT=

# Vercel API: respaldos duraderos en R2 e instantáneas restaurables de Neon.
# BACKUP_STORAGE=r2
# NEON_API_KEY=clave-de-administracion-de-neon
# NEON_PROJECT_ID=identificador-del-proyecto
# NEON_BRANCH_ID=identificador-de-la-rama
# CRON_SECRET=secreto-largo-aleatorio-para-la-tarea-programada

# Solo para leer fotografías guardadas antes de activar R2.
# SERVICE_UPLOAD_DIR=uploads/servicios
