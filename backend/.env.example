# Local database when running backend outside Docker.
#configuracion para neon 
#DATABASE_URL="postgresql://User_admin:TuPasswordSeguro123%21@localhost:5432/Centro_Tecnico_Electronico?schema=public"

DATABASE_URL=postgresql://User_admin:TuPasswordSeguro123!@localhost:5432/Centro_Tecnico_Electronico?schema=public
SQL_DATABASE_URL=postgresql://User_admin:TuPasswordSeguro123!@localhost:5432/Centro_Tecnico_Electronico

# Railway/Neon uses the same variable names, but with the Neon connection string.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# SQL_DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Server
PORT=5000
NODE_ENV=development
JWT_SECRET=tu_secreto_super_seguro
REQUEST_BODY_LIMIT=1mb

# Nombre del negocio en los informes PDF. Personalizable para cada instalación.
PDF_NOMBRE_NEGOCIO=Servicio técnico

# CORS. Use the Railway frontend URL in production.
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# CORS_ORIGIN=http://localhost:5173,https://frontend-production-9a19.up.railway.app

# Admin credentials for development reference.
ADMIN_USER=admin_pro
ADMIN_PASS=admin123

# Fotos de recepción, diagnóstico, reparación y entrega en Cloudflare R2.
# Cree un bucket privado y un token R2 Object Read & Write limitado a ese bucket.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Opcional: endpoint S3 del bucket si usa una jurisdicción (eu, us o fedramp).
R2_ENDPOINT=

# Solo para leer fotografías guardadas antes de activar R2.
# SERVICE_UPLOAD_DIR=uploads/servicios
