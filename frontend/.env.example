# Local browser-to-Vite requests can use the Vite proxy.
VITE_API_URL=/api

# Used only by Vite dev server proxy. Docker compose points this to the backend service.
VITE_PROXY_TARGET=http://localhost:5000

# Vercel frontend should use the public URL of the persistent backend.
# VITE_API_URL=https://api.example.com/api
# VITE_SOCKET_URL=https://api.example.com
# VITE_NOTIFICATIONS_MODE=poll
# VITE_MAX_PHOTO_BYTES=4194304
